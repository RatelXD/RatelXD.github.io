{% macro result(url, title, category, topic, summary, excerpt, dateLabel, date, image, imageAlt, family) %}
{% set fileIcon = 'lab' if family == 'lab' else ('contacts' if family == 'about' else 'document') %}
<a class="desk-result" role="option" aria-selected="false" tabindex="-1" href="{{ url | escape }}"
   data-desk-result data-category="{{ category | escape }}" data-family="{{ family | escape }}"
   data-topic="{{ topic | escape }}" data-summary="{{ summary | escape }}"
   data-excerpt="{{ excerpt | escape }}" data-date="{{ date | escape }}" data-date-label="{{ dateLabel | escape }}"
   {% if image %}data-image="{{ image | escape }}" data-alt="{{ imageAlt | escape }}"{% endif %}>
  <img class="desk-result-icon" src="/assets/media/mac/{{ fileIcon }}.png" width="28" height="28" loading="lazy" alt="">
  <span class="desk-result-text">
    <span class="desk-result-name">{{ title | escape }}</span>
    <span class="desk-result-location">{{ category | escape }}{% if topic %} / {{ topic | escape }}{% endif %}</span>
  </span>
</a>
{% endmacro %}

<dialog class="desk-modal desk-search" id="desk-search" aria-labelledby="desk-search-title">
  <h2 id="desk-search-title" class="visually-hidden">Spotlight 검색</h2>
  <div class="desk-query">
    <svg class="desk-magnifier" viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="13.4" cy="13.4" r="8.8"/><path d="m20.1 20.1 7.2 7.2"/></svg>
    <label for="desk-query-input" class="visually-hidden">Spotlight에서 파일과 앱 검색</label>
    <input id="desk-query-input" type="search" role="combobox" aria-autocomplete="list"
           aria-controls="desk-result-list" aria-expanded="false" autocomplete="off" spellcheck="false"
           enterkeyhint="go" placeholder="Spotlight 검색" autofocus>
    <button type="button" class="desk-tool desk-browse" data-search-all aria-label="전체 항목 보기" title="전체 항목 보기" aria-expanded="false" aria-controls="desk-result-list">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 6.4 4.5 4.2 4.5-4.2"/></svg>
    </button>
    <button class="desk-tool desk-dismiss" data-desk-dismiss type="button" aria-label="Spotlight 닫기" title="닫기"></button>
  </div>
  <div class="desk-search-body" data-search-pane hidden>
    <p class="desk-results-count" role="status" aria-live="polite" aria-atomic="true" data-result-count></p>
    <div class="desk-search-results" data-result-layout>
      <div id="desk-result-list" class="desk-result-list" role="listbox" aria-label="검색 결과">
        {% for section in site.sections %}{% for record in collections[section.id] %}
          {% set excerpt = record.templateContent | previewParagraph | striptags | trim | truncate(350, true, '…') %}
          {{ result(record.url, record.data.title, section.label, record.data.topic or '', record.data.description or '',
                  excerpt, record.data.dateLabel or '발행', record.date | displayDay, record.data.image or '',
                  record.data.imageAlt or '', section.id) }}
        {% endfor %}{% endfor %}
        {{ result('/lab/', '패킷 실습실', '응용 프로그램', '네트워크', '목적지 IPv4 주소에 맞는 경로를 라우팅 테이블에서 확인합니다.',
                '', '', '', '', '', 'lab') }}
        {{ result('/about/', '클라우드 보안 프로필', '프로필', '', '정보보안학과 학생 RatelXD의 관심 분야와 공개 프로젝트를 소개합니다.',
                '', '', '', '', '', 'about') }}
      </div>
      <aside class="desk-hit" aria-label="선택한 검색 결과">
        <img class="desk-hit-miniature" data-hit-image alt="" width="88" height="88">
        <p class="desk-hit-title" data-hit-title></p>
        <p class="desk-hit-meta" data-hit-type></p>
        <p class="desk-hit-summary" data-hit-summary></p>
      </aside>
    </div>
    <div class="desk-no-results" data-empty-search hidden>
      <p>일치하는 파일이나 앱이 없습니다.</p>
      <button type="button" class="desk-reset" data-reset-query>검색어 지우기</button>
    </div>
  </div>
</dialog>

<dialog class="desk-modal desk-look" id="desk-look" aria-labelledby="desk-look-title">
  <header class="desk-look-toolbar">
    <div class="desk-look-controls">
      <button class="desk-tool desk-dismiss" data-desk-dismiss type="button" aria-label="훑어보기 닫기" title="닫기"></button>
      <button class="desk-tool desk-zoom" data-look-zoom type="button" aria-label="훑어보기 확대" aria-pressed="false" title="확대">
        <svg viewBox="0 0 18 18" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.5h4.2v4.2m-4.2-.1 4.2-4.1M7.7 14.5H3.5v-4.2m4.2.1-4.2 4.1"/></svg>
      </button>
    </div>
    <div class="desk-look-filename">
      <img alt="" data-look-icon width="18" height="18">
      <h2 id="desk-look-title" tabindex="-1"></h2>
    </div>
    <a class="desk-open-file" data-open-original>문서 열기</a>
  </header>
  <div class="desk-look-body">
    <article class="desk-look-paper">
      <img class="desk-look-app" data-look-app alt="" width="78" height="78" hidden>
      <h3 data-look-heading></h3>
      <p class="desk-look-summary" data-look-summary></p>
      <img class="desk-look-image" data-look-image hidden alt="">
      <p class="desk-look-excerpt" data-look-excerpt></p>
      <footer class="desk-look-meta"><span data-look-location></span><span data-look-date></span></footer>
    </article>
  </div>
</dialog>
