{% from "os-icons.njk" import icon, appImage %}
{% set home = page.url == "/" %}
{% set lab = page.url == "/lab/" %}
{% set profile = page.url == "/about/" %}
{% set archive = section and page.url == "/" + section + "/" %}
{% set appName = "Finder" if home or archive else ("패킷 실습실" if lab else ("연락처" if profile else "미리보기")) %}
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#c62f59">
  <title>{% if home %}RatelXD의 작업실 | 클라우드 보안 포트폴리오{% else %}{{ title | escape }} | RatelXD의 작업실{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) | escape }}">
  {% if page.url != "/404.html" %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:type" content="{% if section and not archive %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if home %}RatelXD의 작업실{% else %}{{ title | escape }} | RatelXD의 작업실{% endif %}">
  <meta property="og:description" content="{{ description | default(site.description) | escape }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:image" content="{{ site.url }}{{ '/assets/media/social.png' | assetUrl }}">
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Big Sur풍 바탕화면의 Finder에서 RatelXD의 프로젝트와 학습 기록을 탐색하는 화면">
  <link rel="icon" href="{{ '/assets/media/icon.png' | assetUrl }}" type="image/png">
  {% for sheet in ["tokens", "base", "site", "menus", "finder", "desk-dialogs", "reading", "lab"] %}
  <link rel="stylesheet" href="{{ ('/assets/css/' + sheet + '.css') | assetUrl }}">
  {% endfor %}
  {% for script in ["window", "finder", "reading", "lab", "desk-dialogs", "desktop"] %}
  <script src="{{ ('/assets/js/' + script + '.js') | assetUrl }}" defer></script>
  {% endfor %}
</head>
<body class="workspace">
  {% include "symbols.njk" %}
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  {% include "menubar.njk" %}
  <main id="main" class="workspace-stage" tabindex="-1" data-routes="{% for item in collections.all %}{{ item.url }} {% endfor %}">
    <nav class="desktop-files" aria-label="데스크탑 항목">
      <a href="/" data-folder="home">{{ appImage("disk", 62) }}<span>RatelXD HD</span></a>
      <a href="/projects/" data-folder="projects">{{ appImage("folder", 62) }}<span>프로젝트</span></a>
    </nav>
    <div class="os-window {{ 'finder-page' if home else 'reader-window' }}" data-window="{{ page.url }}" data-app-name="{{ appName }}" tabindex="-1" role="region" aria-label="{{ 'Finder' if home else title | escape }}">
      {% include "finder-toolbar.njk" %}
      {% if home %}{{ content | safe }}{% else %}
        <div class="reader-scroll" tabindex="0" role="region" aria-label="{{ title | escape }} 내용">{{ content | safe }}</div>
      {% endif %}
      <button type="button" class="resize-handle enhance" data-resize aria-label="창 크기 조절" title="드래그하거나 방향키로 창 크기 조절"></button>
    </div>
    <button type="button" class="restore-window" data-restore hidden>{{ appImage("finder", 37) }}<span>Finder 열기</span></button>
  </main>
  {% include "desktop-dock.njk" %}
  {% include "desk-dialogs.njk" %}
</body>
</html>
