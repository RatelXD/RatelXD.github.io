{% from "os-icons.njk" import icon, appImage %}
{% set home = page.url == "/" %}
{% set lab = page.url == "/lab/" %}
{% set profile = page.url == "/about/" %}
{% set archive = section and page.url == "/" + section + "/" %}
{% set appName = "Finder" if home or archive else ("패킷 실습실" if lab else ("연락처" if profile else "미리보기")) %}
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#c62f59">
  <title>{% if home %}RatelXD의 작업실 | 클라우드 보안 포트폴리오{% else %}{{ title | escape }} | RatelXD의 작업실{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) | escape }}">
  {% if page.url != "/404.html" %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:type" content="{% if section and not archive %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if home %}RatelXD의 작업실{% else %}{{ title | escape }} | RatelXD의 작업실{% endif %}">
  <meta property="og:description" content="{{ description | default(site.description) | escape }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:image" content="{{ site.url }}{{ '/assets/media/social.png' | assetUrl }}">
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Big Sur풍 바탕화면의 Finder에서 RatelXD의 프로젝트와 학습 기록을 탐색하는 화면">
  <link rel="icon" href="{{ '/assets/media/icon.png' | assetUrl }}" type="image/png">
  {% for sheet in ["tokens", "base", "site", "menus"] %}<link rel="stylesheet" href="{{ ('/assets/css/' + sheet + '.css') | assetUrl }}">
  {% endfor %}
  <script src="{{ '/assets/js/window.js' | assetUrl }}" defer></script>
  <script src="{{ '/assets/js/desktop.js' | assetUrl }}" defer></script>
  {% if home %}
  <link rel="stylesheet" href="{{ '/assets/css/finder.css' | assetUrl }}">
  <link rel="stylesheet" href="{{ '/assets/css/desk-dialogs.css' | assetUrl }}">
  <script src="{{ '/assets/js/finder.js' | assetUrl }}" defer></script>
  <script src="{{ '/assets/js/desk-dialogs.js' | assetUrl }}" defer></script>
  {% elif lab %}
  <link rel="stylesheet" href="{{ '/assets/css/lab.css' | assetUrl }}"><script src="{{ '/assets/js/lab.js' | assetUrl }}" defer></script>
  {% else %}
  <link rel="stylesheet" href="{{ '/assets/css/reading.css' | assetUrl }}"><script src="{{ '/assets/js/reading.js' | assetUrl }}" defer></script>
  {% endif %}
</head>
<body class="workspace {% if home %}finder-page{% else %}reader-page{% endif %}">
  {% include "symbols.njk" %}
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  {% include "menubar.njk" %}
  <main id="main" class="workspace-stage" tabindex="-1">
    <nav class="desktop-files" aria-label="데스크탑 항목">
      <a href="/"{% if home %} data-folder="home"{% endif %}>{{ appImage("disk", 62) }}<span>RatelXD HD</span></a>
      <a href="/projects/"{% if home %} data-folder="projects"{% endif %}>{{ appImage("folder", 62) }}<span>프로젝트</span></a>
    </nav>
    <div class="os-window{% if not home %} reader-window{% endif %}" data-window>
      {% include "finder-toolbar.njk" %}
      {% if home %}{{ content | safe }}{% else %}
        <div class="reader-scroll" tabindex="0" role="region" aria-label="{{ title | escape }} 내용">{{ content | safe }}</div>
      {% endif %}
      <button type="button" class="resize-handle enhance" data-resize aria-label="창 크기 조절" title="드래그하거나 방향키로 창 크기 조절"></button>
    </div>
    <button type="button" class="restore-window" data-restore hidden>{{ appImage("finder" if home else ("lab" if lab else ("contacts" if profile else "preview")), 37) }}{{ appName }} 열기</button>
  </main>
  {% include "desktop-dock.njk" %}
  {% if home %}{% include "desk-dialogs.njk" %}{% endif %}
</body>
</html>
