<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == "/" %}RatelXD Notes | 클라우드 보안 기록{% else %}{{ title | escape }} | RatelXD Notes{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) | escape }}">
  {% if page.url != "/404.html" %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:title" content="{{ title | default('클라우드 보안 기록') | escape }} | RatelXD Notes">
  <meta property="og:description" content="{{ description | default(site.description) | escape }}">
  <meta property="og:type" content="{% if section and page.fileSlug and page.url != '/' + section + '/' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:image" content="{{ site.url }}/assets/media/social.png">
  <link rel="icon" href="/assets/media/icon.png" type="image/png">
  <link rel="stylesheet" href="{% if page.url == '/404.html' %}/assets/css/site.css{% else %}{{ '/assets/css/site.css' | assetPath(page.url) }}{% endif %}">
  {% if page.url != "/" %}
  <link rel="stylesheet" href="{% if page.url == '/404.html' %}/assets/css/reading.css{% else %}{{ '/assets/css/reading.css' | assetPath(page.url) }}{% endif %}">
  <script src="/assets/js/reading.js" defer></script>
  {% endif %}
</head>
<body class="{% if page.url == '/' %}front-page{% else %}inner-page{% endif %}">
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="mast container">
    {% if page.url == "/" %}
    <div class="nameplate">
      <h1 class="wordmark"><a href="/" aria-label="RatelXD Notes 홈">RatelXD Notes</a></h1>
      <p class="colophon">클라우드와 인프라를 공부하는<br> 정보보안학과 학생의 기록.</p>
    </div>
    {% endif %}
    <nav class="mast-nav" aria-label="주 메뉴">
      {% if page.url != "/" %}<a class="smallmark" href="/" aria-label="RatelXD Notes 홈">RatelXD Notes</a>{% endif %}
      <div class="nav-sections">
        {% for item in site.sections %}<a href="/{{ item.id }}/"{% if section == item.id %} aria-current="{% if page.url == '/' + item.id + '/' %}page{% else %}location{% endif %}"{% endif %}>{{ item.label }}</a>{% endfor %}
      </div>
      <div class="nav-author"><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>소개</a><a class="git-link" href="{{ site.github }}" aria-label="RatelXD GitHub 프로필">GitHub</a></div>
    </nav>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="container site-footer">
    <div class="footer-line"><a class="smallmark" href="/">RatelXD Notes</a><nav aria-label="바닥글"><a href="/about/">소개</a><a href="{{ site.github }}">GitHub</a></nav></div>
    {% if page.url == "/" %}
    <p class="credit">표지 사진 <a href="https://commons.wikimedia.org/wiki/File:Network_switches.jpg">Network switches, Jon “ShakataGaNai” Davis</a>. 원본을 잘라 색을 조정했습니다. <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a></p>
    {% endif %}
  </footer>
</body>
</html>
