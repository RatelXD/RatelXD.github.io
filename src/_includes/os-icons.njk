{% macro icon(name, size = 20) %}<svg aria-hidden="true" focusable="false" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" class="glyph"><use href="#symbol-{{ name }}"/></svg>{% endmacro %}
{% macro appImage(name, size = 48) %}<img src="/assets/media/mac/{{ name }}.png" width="{{ size }}" height="{{ size }}" alt="" draggable="false">{% endmacro %}
