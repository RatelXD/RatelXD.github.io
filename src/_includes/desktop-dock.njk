{% from "os-icons.njk" import icon, appImage %}
<div class="dock-area">
  <nav class="dock" aria-label="Dock">
    {% set apps = [
      {id:"finder", label:"Finder", url:"/", current:home},
      {id:"notes", label:"학습 노트", url:"/notes/", current:page.url == "/notes/"},
      {id:"preview", label:"프로젝트", url:"/projects/", current:page.url == "/projects/"},
      {id:"contacts", label:"RatelXD 소개", url:"/about/", current:profile},
      {id:"lab", label:"패킷 실습실", url:"/lab/", current:lab}
    ] %}
    {% for app in apps %}
    <a class="dock-app{% if app.current %} running{% endif %}" data-dock-app href="{{ app.url }}" aria-label="{{ app.label }}"{% if app.current %} aria-current="page"{% endif %}>
      {{ appImage(app.id, 64) }}<span class="dock-label" aria-hidden="true">{{ app.label }}</span>
    </a>
    {% endfor %}
    <span class="dock-divider" aria-hidden="true"></span>
    <details class="dock-stack">
      <summary class="dock-app" aria-label="최근 문서">{{ appImage("stack",64) }}<span class="dock-label" aria-hidden="true">최근 문서</span></summary>
      <div class="stack-sheet"><strong>최근 문서</strong><ul>{% for file in collections.recentFiles %}<li><a href="{{ file.url }}">{{ appImage("document", 23) }}<span>{{ file.data.title | escape }}</span></a></li>{% endfor %}</ul><a class="stack-all" href="/?folder=recent">Finder에서 열기</a></div>
    </details>
    <a class="dock-app" href="{{ site.github }}" target="_blank" rel="noopener" aria-label="GitHub 프로필 (새 탭)">
      <img src="{{ '/assets/media/mac/github.svg' | assetUrl }}" width="64" height="64" alt="" draggable="false"><span class="dock-label" aria-hidden="true">GitHub</span>
    </a>
  </nav>
</div>
<p class="desk-notice" role="status" aria-live="polite" data-desk-notice></p>
