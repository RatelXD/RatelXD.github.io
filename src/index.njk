---
layout: base.njk
title: RatelXD의 작업실
---
{% from "os-icons.njk" import icon, folder, fileRow %}
<div class="finder">
  <aside class="locations" aria-label="탐색기 사이드바">
    <a href="/about/" class="account"><img src="/assets/media/profile.webp" width="38" height="38" alt=""><span><strong>RatelXD</strong><small>정보보안학과</small></span></a>
    <nav class="folder-nav" aria-label="폴더 탐색">
      <a class="location chosen" href="/" data-folder="home">{{ icon("desktop") }}<span>내 작업실</span></a>
      {% for item in site.sections %}
      <a class="location" href="/{{ item.id }}/" data-folder="{{ item.id }}">{{ icon(item.id) }}<span>{{ item.label }}</span></a>
      {% endfor %}
    </nav>
    <nav class="utilities" aria-label="작업 도구"><a class="location" href="/lab/">{{ icon("lab") }}<span>패킷 실습실</span></a><a class="location" href="{{ site.github }}">{{ icon("github") }}<span>GitHub</span></a></nav>
  </aside>
  <div class="file-area" id="files">
    <section class="folder-panel" data-panel="home" data-count="{{ collections.pinnedFiles.length }}" aria-labelledby="workspace-title">
      <h1 id="workspace-title" tabindex="-1">RatelXD의 작업실</h1>
      <p class="finder-intro">클라우드 보안을 공부하며 만든 도구와 실습 기록을 모았습니다.</p>
      <nav class="folder-shelf" aria-label="작업실 폴더">
        {% for id in ["projects","notes","activities"] %}{% set item = id | sectionById %}
        <a href="/{{ id }}/" class="shelf-item" data-folder="{{ id }}">{{ folder(id,id) }}<span>{{ item.label }}</span><small>{{ collections[id].length }}개 항목</small></a>
        {% endfor %}
      </nav>
      <div class="file-heading"><h2>{{ icon("pin",17) }} 고정한 파일</h2></div>
      <ul class="file-list">{% for entry in collections.pinnedFiles %}{{ fileRow(entry) }}{% endfor %}</ul>
    </section>
    {% for item in site.sections %}
    <section class="folder-panel" data-panel="{{ item.id }}" data-count="{{ collections[item.id].length }}" aria-labelledby="heading-{{ item.id }}" hidden>
      <div class="folder-top">
        <h1 id="heading-{{ item.id }}" tabindex="-1">{{ item.label }}</h1>
        <div class="view-mode enhance" role="group" aria-label="파일 보기 방식">
          <button type="button" data-layout="list" aria-label="목록 보기" aria-pressed="true" title="목록 보기">{{ icon("list",17) }}</button>
          <button type="button" data-layout="grid" aria-label="아이콘 보기" aria-pressed="false" title="아이콘 보기">{{ icon("grid",16) }}</button>
        </div>
      </div>
      <p class="finder-intro">{{ item.description }}</p>
      <ul class="file-list collection-files">{% for entry in collections[item.id] %}{{ fileRow(entry) }}{% endfor %}</ul>
      <a class="archive-shortcut" href="/{{ item.id }}/">{{ item.label }} 목록 페이지 열기</a>
    </section>
    {% endfor %}
  </div>
</div>
<div class="finder-status"><span>{{ icon("folder",15) }}<span data-status-path>내 작업실</span></span><span class="status-tip enhance"><kbd>Space</kbd><span class="touch-eye">{{ icon("eye",14) }} 눈 아이콘으로</span> 미리보기</span></div>
